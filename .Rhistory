getwd()
list.files()
list.files("results")
list.files("scripts")
getwd()
bench <- read.csv("results/benchmark_results.csv")
head(bench)
names(bench)
str(bench)
dim(bench)
# Check whether all algorithms sorted correctly
table(bench$correct)
# Count observations by algorithm
table(bench$algorithm)
# Check input sizes and input types
table(bench$input_size)
table(bench$input_type)
# Check missing values
colSums(is.na(bench))
# Convert columns to appropriate data types
bench$algorithm <- factor(bench$algorithm)
bench$input_type <- factor(bench$input_type)
bench$correct <- tolower(bench$correct) == "true"
# Verify data
str(bench)
# Calculate summary statistics
library(dplyr)
install.packages("dplyr")
# Calculate summary statistics
library(dplyr)
summary_stats <- bench %>%
group_by(algorithm, input_size, input_type) %>%
summarise(
trials = n(),
mean_seconds = mean(runtime_seconds),
median_seconds = median(runtime_seconds),
variance = var(runtime_seconds),
sd_seconds = sd(runtime_seconds),
.groups = "drop"
)
print(summary_stats, n = 12)
library(ggplot2)
install.packages("ggplot2")
library(ggplot2)
ggplot(
subset(bench, input_type == "random"),
aes(
x = algorithm,
y = runtime_seconds * 1000,
fill = algorithm
)
) +
geom_boxplot() +
facet_wrap(~input_size, scales = "free_y") +
labs(
title = "Sorting Algorithm Runtime Comparison",
subtitle = "Random inputs across different input sizes",
x = "Sorting Algorithm",
y = "Runtime (milliseconds)"
) +
theme_minimal() +
theme(legend.position = "none")
dir.create("outputs/figures",
recursive = TRUE,
showWarnings = FALSE)
ggsave(
"outputs/figures/review1_boxplot.png",
width = 10,
height = 6,
dpi = 300
)
write.csv(
summary_stats,
"outputs/tables/review1_summary.csv",
row.names = FALSE
)
file.exists("outputs/figures/review1_boxplot.png")
file.exists("outputs/tables/review1_summary.csv")
library(ggplot2)
random_data <- subset(bench, input_type == "random")
mean_runtime <- aggregate(
runtime_seconds ~ algorithm + input_size,
data = random_data,
FUN = mean
)
p <- ggplot(
mean_runtime,
aes(
x = input_size,
y = runtime_seconds * 1000,
color = algorithm,
group = algorithm
)
) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
labs(
title = "Runtime vs Input Size",
subtitle = "Mean runtime over repeated trials on random inputs",
x = "Input Size",
y = "Mean Runtime (milliseconds)",
color = "Algorithm"
) +
theme_minimal()
print(p)
ggsave(
"outputs/figures/runtime_vs_input_size_review1.png",
plot = p,
width = 9,
height = 6,
dpi = 300
)
ggsave(
filename = "outputs/figures/runtime_vs_input_size_review1.png",
plot = p,
width = 12,
height = 7,
dpi = 300
)
file.exists("outputs/figures/runtime_vs_input_size_review1.png")
list.files("outputs/tables")
library(dplyr)
library(ggplot2)
# Select one controlled experimental condition
ci_data <- subset(
bench,
input_size == 1000 & input_type == "random"
)
# Calculate 95% confidence intervals
ci_results <- ci_data %>%
group_by(algorithm) %>%
summarise(
n = n(),
mean_seconds = mean(runtime_seconds),
sd_seconds = sd(runtime_seconds),
standard_error = sd_seconds / sqrt(n),
margin_error = qt(0.975, df = n - 1) * standard_error,
lower_95 = mean_seconds - margin_error,
upper_95 = mean_seconds + margin_error,
.groups = "drop"
) %>%
mutate(
across(
c(mean_seconds, sd_seconds, standard_error,
lower_95, upper_95),
~ .x * 1000
)
)
print(ci_results)
ci_plot <- ggplot(
ci_results,
aes(
x = algorithm,
y = mean_seconds,
color = algorithm
)
) +
geom_point(size = 4) +
geom_errorbar(
aes(ymin = lower_95, ymax = upper_95),
width = 0.18,
linewidth = 1
) +
labs(
title = "95% Confidence Intervals for Sorting Runtime",
subtitle = "Random inputs, input size = 1000",
x = "Sorting Algorithm",
y = "Mean Runtime (milliseconds)"
) +
theme_minimal() +
theme(legend.position = "none")
print(ci_plot)
ggsave(
"outputs/figures/confidence_intervals_review1.png",
plot = ci_plot,
width = 10,
height = 6,
dpi = 300
)
write.csv(
ci_results,
"outputs/tables/confidence_intervals_review1.csv",
row.names = FALSE
)
file.exists("outputs/tables/confidence_intervals_review1.csv")
file.exists("outputs/figures/confidence_intervals_review1.png")
